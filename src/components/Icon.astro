---
// Small inline icon set (stroke icons, inherit currentColor).
interface Props {
  name:
    | 'arrow'
    | 'heart'
    | 'book'
    | 'check'
    | 'sparkle'
    | 'mail'
    | 'chat'
    | 'users'
    | 'instagram'
    | 'facebook'
    | 'tiktok';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {
    name === 'heart' && (
      <path d="M12 20s-7-4.35-9.2-8.6C1.2 8.3 3 4.5 6.6 4.5c2.1 0 3.6 1.2 5.4 3.2 1.8-2 3.3-3.2 5.4-3.2 3.6 0 5.4 3.8 3.8 6.9C19 15.65 12 20 12 20Z" />
    )
  }
  {
    name === 'book' && (
      <>
        <path d="M12 6.5C10.2 5 7.6 4.5 4 4.5v14c3.6 0 6.2.5 8 2 1.8-1.5 4.4-2 8-2v-14c-3.6 0-6.2.5-8 2Z" />
        <path d="M12 6.5v14" />
      </>
    )
  }
  {
    name === 'check' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="m8.5 12.2 2.4 2.4 4.8-5" />
      </>
    )
  }
  {
    name === 'sparkle' && (
      <path d="M12 3.5c.6 4.2 2.3 5.9 6.5 6.5-4.2.6-5.9 2.3-6.5 6.5-.6-4.2-2.3-5.9-6.5-6.5 4.2-.6 5.9-2.3 6.5-6.5ZM18.5 15.5c.3 1.6.9 2.2 2.5 2.5-1.6.3-2.2.9-2.5 2.5-.3-1.6-.9-2.2-2.5-2.5 1.6-.3 2.2-.9 2.5-2.5Z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5.5" width="18" height="13" rx="3" />
        <path d="m4 7.5 8 6 8-6" />
      </>
    )
  }
  {
    name === 'chat' && (
      <path d="M20 12c0 4-3.6 7-8 7-1.2 0-2.3-.2-3.3-.6L4 19.5l1.2-3.6C4.4 14.8 4 13.4 4 12c0-4 3.6-7 8-7s8 3 8 7Z" />
    )
  }
  {
    name === 'users' && (
      <>
        <circle cx="9" cy="8.5" r="3.5" />
        <path d="M2.5 19.5c.6-3.3 3.2-5.5 6.5-5.5s5.9 2.2 6.5 5.5" />
        <path d="M15.5 5.2a3.5 3.5 0 0 1 0 6.6M18 14.4c1.9.8 3.2 2.7 3.5 5.1" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" />
      </>
    )
  }
  {name === 'facebook' && <path d="M14.5 8H17V4.5h-2.5c-2.5 0-4 1.6-4 4V11H8v3.5h2.5v6H14v-6h2.6l.5-3.5H14V8.8c0-.5.3-.8.5-.8Z" />}
  {name === 'tiktok' && <path d="M14 3.5v11.2a3.3 3.3 0 1 1-2.8-3.3M14 3.5c.4 2.6 2.2 4.4 5 4.6" />}
</svg>
