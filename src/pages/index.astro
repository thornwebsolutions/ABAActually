---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import founders from '../assets/founders.jpg';
import badge from '../assets/badge.png';

const pillars = [
  {
    icon: 'sparkle',
    title: 'Created by BCBAs',
    text: 'Everything we share comes from Board Certified Behavior Analysts with years of hands-on experience alongside kids and families.',
  },
  {
    icon: 'heart',
    title: 'Written for parents',
    text: 'No jargon walls. Just clear, practical explanations you can actually understand and use at home, at school, and everywhere in between.',
  },
  {
    icon: 'book',
    title: 'Grounded in evidence',
    text: "We stick to what the research supports, so you can feel confident about the information guiding your family's decisions.",
  },
] as const;
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <span class="blob hb1" aria-hidden="true"></span>
    <span class="blob hb2" aria-hidden="true"></span>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Created by BCBAs &middot; Written for parents</p>
        <h1>
          Making ABA <span class="script">actually</span>{' '}
          <span class="swash">make sense.</span>
        </h1>
        <p class="lead">
          Clear, practical, evidence-based information about autism and Applied Behavior Analysis, from two BCBAs who
          saw a need for parents and decided to do something about it.
        </p>
        <div class="btn-row">
          <a class="btn" href="/contact">Get in touch <Icon name="arrow" /></a>
          <a class="btn btn--outline" href="/about">Meet the founders</a>
        </div>
      </div>

      <div class="hero-media">
        <div class="photo-frame">
          <Image
            src={founders}
            alt="ABA Actually co-founders Sydney Horn and Katlynn Burns smiling in matching pink blazers"
            widths={[480, 720, 960]}
            sizes="(max-width: 900px) 90vw, 520px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="float-chip chip-1">
          <Icon name="check" /> BCBA-led
        </div>
        <div class="float-chip chip-2">
          <Icon name="heart" /> Women-owned
        </div>
      </div>
    </div>
    <svg class="wave hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 50 C 300 0, 560 90, 860 45 S 1260 10, 1440 50 V80 H0Z" fill="#fff"></path>
    </svg>
  </section>

  <!-- Pillars -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What makes us different</p>
        <h2>Information you can <span class="script">actually</span> use</h2>
        <p>Parents deserve answers that are accurate, approachable, and made with them in mind.</p>
      </div>
      <div class="pillars">
        {
          pillars.map((p, i) => (
            <article class="card pillar" data-reveal style={`transition-delay:${i * 100}ms`}>
              <div class="icon-bubble">
                <Icon name={p.icon} />
              </div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section section--blush story">
    <div class="container story-grid">
      <div class="story-media" data-reveal>
        <Image src={badge} alt="ABA Actually badge: Created by BCBAs. Written for parents. Grounded in evidence." widths={[360, 540, 720]} sizes="(max-width: 900px) 70vw, 440px" />
      </div>
      <div class="story-copy" data-reveal>
        <p class="eyebrow">Why ABA Actually?</p>
        <h2>Two BCBAs. <br />One mission.</h2>
        <p class="lead">
          We're two BCBAs and friends who saw a need: a place where parents could find clear, practical, evidence-based
          information about autism and ABA.
        </p>
        <p>
          Our goal is simple: to help bridge the gap between clinical knowledge and parents navigating an autism
          diagnosis. We give families information, answers, and resources they can{' '}
          <em>actually</em> understand and use.
        </p>
        <a class="btn" href="/about">Our story <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Services teaser -->
  <section class="section teaser-section">
    <div class="container">
      <div class="teaser" data-reveal>
        <div class="icon-bubble"><Icon name="sparkle" /></div>
        <div>
          <p class="eyebrow">Coming soon</p>
          <h2>Something good is on its way</h2>
          <p>
            We're putting the finishing touches on our services. Reach out and we'll let you know as soon as
            they're ready.
          </p>
        </div>
        <a class="btn btn--outline" href="/services">Learn more</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    background: var(--blush);
    padding-top: clamp(48px, 7vw, 96px);
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .hero h1 .script {
    font-size: 1.2em;
  }
  .hero .lead {
    margin-bottom: 36px;
  }
  .hb1 {
    width: 520px;
    height: 520px;
    background: var(--accent);
    opacity: 0.45;
    top: -180px;
    right: -140px;
  }
  .hb2 {
    width: 260px;
    height: 260px;
    background: #fff;
    opacity: 0.6;
    bottom: 40px;
    left: -110px;
  }
  .hero-media {
    position: relative;
    justify-self: center;
    width: min(100%, 540px);
  }
  .photo-frame {
    position: relative;
    border-radius: 46% 54% 42% 58% / 52% 44% 56% 48%;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border: 10px solid #fff;
    box-shadow: var(--shadow);
    background: #fff;
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .float-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #fff;
    border-radius: 999px;
    box-shadow: var(--shadow-soft);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--text);
    animation: bob 5s ease-in-out infinite;
  }
  .float-chip :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--primary);
  }
  .chip-1 {
    top: 12%;
    left: -6%;
  }
  .chip-2 {
    bottom: 10%;
    right: -4%;
    animation-delay: -2.5s;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .hero-wave {
    position: relative;
    z-index: 1;
    margin-bottom: -1px;
  }

  /* Pillars */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .pillar {
    border-top: 5px solid var(--accent);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.7s ease;
  }
  .pillar:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .pillar p {
    color: var(--text-soft);
    margin: 0;
  }

  /* Story */
  .story-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }
  .story-media {
    justify-self: center;
    width: min(100%, 440px);
  }
  .story-media img {
    width: 100%;
    filter: drop-shadow(0 24px 40px rgba(199, 30, 101, 0.2));
  }

  /* Teaser */
  .teaser-section {
    padding-bottom: 0;
  }
  .teaser {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 32px;
    padding: clamp(32px, 5vw, 48px);
    border: 2px dashed var(--accent);
    border-radius: var(--radius-lg);
    background: var(--blush-soft);
  }
  .teaser .icon-bubble {
    margin: 0;
    width: 80px;
    height: 80px;
  }
  .teaser h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .teaser p:last-child {
    margin: 0;
    color: var(--text-soft);
  }

  @media (max-width: 900px) {
    .hero-grid,
    .story-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      text-align: center;
    }
    .hero .lead {
      margin-inline: auto;
    }
    .hero .btn-row {
      justify-content: center;
    }
    .pillars {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
    .story-media {
      width: min(80%, 360px);
    }
    .teaser {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }
  @media (max-width: 480px) {
    .chip-1 {
      left: 0;
    }
    .chip-2 {
      right: 0;
    }
  }
</style>
