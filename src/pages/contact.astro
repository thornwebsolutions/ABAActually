---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
---

<Layout title="Contact" description="Get in touch with ABA Actually. We'd love to hear from you.">
  <section class="page-hero">
    <span class="blob cb1" aria-hidden="true"></span>
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>We'd <span class="script">love</span> to hear from you</h1>
      <p class="lead">
        Questions, ideas, or just want to say hi? Send us a note and one of us will get back to you soon.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <aside class="info card">
        <h2>Other ways to reach us</h2>
        <ul class="info-list">
          <li>
            <span class="info-icon"><Icon name="mail" /></span>
            <div>
              <p class="info-label">Email</p>
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </div>
          </li>
          <li>
            <span class="info-icon"><Icon name="chat" /></span>
            <div>
              <p class="info-label">Social</p>
              <ul class="social-inline">
                {
                  SITE.social.map((s) => (
                    <li>
                      <a href={s.href} target="_blank" rel="noopener noreferrer">
                        <Icon name={s.icon} />
                        {s.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>
        </ul>
        <p class="note">
          Please don't include private health information in your message. This form isn't monitored for urgent needs.
        </p>
      </aside>

      <form id="contact-form" class="card contact-form" method="post" action="/api/contact" novalidate>
        <div class="field-row">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
          </div>
        </div>

        <fieldset class="field">
          <legend>I am a...</legend>
          <div class="pills">
            {
              ['Parent or caregiver', 'Professional', 'Other'].map((r, i) => (
                <label class="pill">
                  <input type="radio" name="role" value={r} checked={i === 0} />
                  <span>{r}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" rows="6" required maxlength="5000"></textarea>
        </div>

        <!-- Honeypot for bots -->
        <div class="hp" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn submit" type="submit">
          <span class="label">Send message</span>
          <Icon name="arrow" />
        </button>

        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--blush);
    text-align: center;
    padding: clamp(56px, 8vw, 104px) 0 clamp(120px, 14vw, 180px);
  }
  .page-hero .container {
    position: relative;
    z-index: 1;
  }
  .page-hero .lead {
    margin-inline: auto;
  }
  .cb1 {
    width: 440px;
    height: 440px;
    background: var(--accent);
    opacity: 0.4;
    top: -220px;
    right: -120px;
  }

  .contact-section {
    position: relative;
    z-index: 2;
    margin-top: clamp(-140px, -10vw, -80px);
    padding-bottom: var(--section-y);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 28px;
    align-items: start;
  }

  /* Info card */
  .info h2 {
    font-size: 1.5rem;
    margin-bottom: 24px;
  }
  .info-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    gap: 24px;
  }
  .info-list > li {
    display: flex;
    gap: 16px;
  }
  .info-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--blush);
    color: var(--primary);
  }
  .info-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .info-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  .info a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .social-inline {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: grid;
    gap: 6px;
  }
  .social-inline a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .social-inline a:hover {
    text-decoration: underline;
  }
  .social-inline :global(svg) {
    width: 18px;
    height: 18px;
  }
  .note {
    font-size: 0.9rem;
    color: var(--text-soft);
    background: var(--blush-soft);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin: 0;
  }

  /* Form */
  .contact-form {
    display: grid;
    gap: 22px;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .field {
    display: grid;
    gap: 8px;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  label,
  legend {
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0;
  }
  legend {
    margin-bottom: 8px;
  }
  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    font: inherit;
    color: var(--text);
    background: var(--blush-soft);
    border: 2px solid var(--blush);
    border-radius: var(--radius-sm);
    padding: 13px 16px;
    transition:
      border-color 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
    min-height: 150px;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--secondary);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(237, 68, 137, 0.15);
  }
  .field.invalid input,
  .field.invalid textarea {
    border-color: var(--primary);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pill {
    position: relative;
    cursor: pointer;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .pill span {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    border: 2px solid var(--blush);
    background: var(--blush-soft);
    font-weight: 700;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .pill input:checked + span {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }
  .pill input:focus-visible + span {
    outline: 3px solid var(--secondary);
    outline-offset: 3px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    justify-self: start;
  }
  .submit[disabled] {
    opacity: 0.7;
    cursor: progress;
    transform: none;
  }

  .status {
    margin: 0;
    font-weight: 700;
  }
  .status:empty {
    display: none;
  }
  .status.ok {
    color: #1f7a4d;
    background: #e8f6ee;
    padding: 14px 18px;
    border-radius: var(--radius-sm);
  }
  .status.err {
    color: var(--primary-dark);
    background: var(--blush);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-form {
      order: -1;
    }
  }
  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
    .submit {
      justify-self: stretch;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLParagraphElement>('.status');
  const button = form?.querySelector<HTMLButtonElement>('.submit');
  const label = button?.querySelector<HTMLSpanElement>('.label');

  const show = (ok: boolean, msg: string) => {
    if (!status) return;
    status.className = `status ${ok ? 'ok' : 'err'}`;
    status.textContent = msg;
  };

  // No-JS fallback lands back here with ?status=...
  const qs = new URLSearchParams(location.search).get('status');
  if (qs === 'sent') show(true, "Thanks for reaching out! We'll get back to you soon.");
  if (qs === 'error') show(false, 'Something went wrong sending your message. Please try again or email us directly.');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Client-side validation with friendly messages
    let firstInvalid: HTMLElement | null = null;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]').forEach((el) => {
      const bad = !el.checkValidity() || !el.value.trim();
      el.closest('.field')?.classList.toggle('invalid', bad);
      el.setAttribute('aria-invalid', String(bad));
      if (bad && !firstInvalid) firstInvalid = el;
    });
    if (firstInvalid) {
      show(false, 'Please fill in your name, a valid email, and a message.');
      (firstInvalid as HTMLElement).focus();
      return;
    }

    button!.disabled = true;
    label!.textContent = 'Sending...';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await res.json().catch(() => ({ ok: false }));
      if (res.ok && data.ok) {
        form.reset();
        show(true, data.message);
      } else {
        show(false, data.message || 'Something went wrong. Please try again.');
      }
    } catch {
      show(false, 'Network error. Please check your connection and try again.');
    } finally {
      button!.disabled = false;
      label!.textContent = 'Send message';
    }
  });
</script>
