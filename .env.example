# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Where contact form submissions are delivered
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend.
# The default onboarding@resend.dev only delivers to the Resend account owner's email (good for testing).
CONTACT_FROM_EMAIL="ABA Actually Website <onboarding@resend.dev>"
